{
  "name": "kiro-banking-cdk",
  "version": "2.0.0",
  "description": "AWS CDK infrastructure for MAS-aligned Kiro banking environments",
  "bin": {
    "kiro-banking": "build/bin/kiro-banking.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all",
    "diff": "cdk diff",
    "lint": "eslint .",
    "nag": "cdk synth 2>&1 | grep -E '(AwsSolutions|Warning|Error)'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1145.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.273.0",
    "cdk-nag": "^2.38.2",
    "constructs": "^10.8.1"
  }
}
