{
  "name": "banking-secure",
  "description": "MAS-aligned least-privilege Kiro agent for banking SDLC (defense in depth; primary control is managed-settings)",
  "tools": ["read", "write", "shell"],
  "allowedTools": ["read"],
  "permissions": {
    "rules": [
      { "capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git branch", "git branch --list*"], "effect": "allow" },
      { "capability": "shell", "match": ["npm run lint*", "npx tsc --noEmit*"], "effect": "allow" },
      { "capability": "shell", "match": ["npm test*", "npm run test*", "git add *", "git commit *"], "effect": "ask" },
      { "capability": "fs_write", "match": ["src/**", "docs/**"], "effect": "allow" },
      { "capability": "fs_read", "match": ["**/.env", "**/.env.*", "**/*.pem", "**/*.key", "**/.ssh/**", "**/.aws/credentials", "secrets/**"], "exclude": ["**/.env.example"], "effect": "deny" },
      { "capability": "fs_write", "match": ["**/.env", "**/.env.*", "**/*.pem", "**/*.key", "**/.ssh/**", "**/.aws/**"], "effect": "deny" },
      { "capability": "shell", "match": ["git push --force*", "git push * --force*", "git push -f*", "git push * -f*", "git reset --hard*", "sudo *", "curl *", "wget *", "aws iam *"], "effect": "deny" },
      { "capability": "shell", "match": ["git push*"], "effect": "ask" }
    ]
  },
  "hooks": {
    "preToolUse": [
      { "matcher": "*", "command": "/opt/kiro/hooks/pii-guard.sh", "timeout_ms": 5000 },
      { "matcher": "execute_bash", "command": "/opt/kiro/hooks/git-guard.sh", "timeout_ms": 5000 },
      { "matcher": "execute_bash", "command": "/opt/kiro/hooks/destructive-fs-guard.sh", "timeout_ms": 5000 }
    ],
    "postToolUse": [
      { "matcher": "*", "command": "/opt/kiro/hooks/audit-logger.sh", "timeout_ms": 5000 }
    ]
  },
  "resources": [
    "file://AGENTS.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/*/SKILL.md"
  ]
}
